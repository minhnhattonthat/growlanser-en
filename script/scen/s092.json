  {
   "id": "scen092.0002",
   "jp": "カレン",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0003",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen092.0004",
   "jp": "　　　　{FFF0}熱烈歓迎{FFF1}{n}グランシル市　　観光協会",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0005",
   "jp": "{v:0048}キャアアッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0006",
   "jp": "{v:0049}この声は！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0007",
   "jp": "お兄ちゃん！{n}あの人を置いていって、どこへ行くつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0008",
   "jp": "‥‥{v:004A}う‥うぅ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0009",
   "jp": "{v:004B}へっへっへっ！{n}悪ィな、姉ちゃんよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0010",
   "jp": "{v:004C}ああ、アンタは！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0011",
   "jp": "{v:004D}チッ！{n}お前らか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0012",
   "jp": "{v:004E}ええい、捕まってたまるか！{n}引き上げるぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0013",
   "jp": "{v:004F}へい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0014",
   "jp": "{v:0050}逃がさないわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0015",
   "jp": "{v:0051}橋を落とされた！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0016",
   "jp": "{v:0052}用意周到な奴め‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0017",
   "jp": "‥‥{v:0053}逃げられちゃったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0018",
   "jp": "{v:0054}みんな、早く来て！{n}この人ひどい傷だよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0019",
   "jp": "{v:0056}今の物音は何だ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0020",
   "jp": "{v:0057}あ、ゼノスさん！{n}カレンさんが！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0021",
   "jp": "{v:0058}何っ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0022",
   "jp": "{v:0059}カ、カレン！{n}しっかりしろ、カレン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0023",
   "jp": "早く手当てしないと‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0024",
   "jp": "困ったな‥‥。{n}これじゃラージン砦に戻れないぞ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0025",
   "jp": "そろそろ大工が来てもいいんだが‥‥。{n}後少し、辛抱してみるか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0026",
   "jp": "もう大工を呼んだって話なんだが、{n}一体、いつになったらここへ来るんだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0027",
   "jp": "オズワルドって賊が、{n}この橋を落としたそうね‥‥。{p}もし見つけたら、おしおきしてやるのに！{n}くやし～！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0028",
   "jp": "お兄ちゃん！{n}あの人を置いていって、どうするつもり？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen092.0029",
   "jp": "お兄ちゃん！{n}ウォレスさんを置いていって、どうするつもり？",
   "en": "",
   "term": "end"
  }
 ]
}
