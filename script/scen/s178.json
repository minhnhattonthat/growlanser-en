  {
   "id": "scen178.0001",
   "jp": "ガーディアン・システム",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen178.0002",
   "jp": "{v:002D}システム閉鎖まで、後１０００カウント。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0003",
   "jp": "{v:002E}システム閉鎖まで、後６００カウント。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0004",
   "jp": "{v:002F}システム閉鎖まで、後４００カウント。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0005",
   "jp": "{v:0030}システム閉鎖まで、後２００カウント。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0006",
   "jp": "{v:0031}これより、システムを閉鎖します。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0007",
   "jp": "{v:0032}間に合わなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0008",
   "jp": "ねぇ！{n}あの真ん中のデッカイの！{p}傷を与えても、すぐに元に戻っちゃうみたいだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0009",
   "jp": "どうしよう‥‥。{n}これじゃ、倒せないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0010",
   "jp": "{s:0000}！{n}このまま無闇に戦っても、勝ち目はない。{n}いったん、出直した方が良くないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0011",
   "jp": "退却しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0012",
   "jp": "{v:0033}損傷により機能不全‥‥。{n}‥‥全防衛管理システムに支障‥‥。{p}{v:0034}残存防衛システムを個別モードでロック‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0013",
   "jp": "これで残りをつぶせる。{n}一気に行こうぜ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0014",
   "jp": "‥‥損傷度‥‥９５％オーバー‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0015",
   "jp": "ガーディアンの修復モード起動。{n}修復操作、開始。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0016",
   "jp": "修復完了。{n}攻撃、開始。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0017",
   "jp": "くっ‥‥。{n}これではキリがないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0018",
   "jp": "くそっ‥‥。{n}これではキリがないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0019",
   "jp": "‥‥{v:0016}損傷度‥‥９５％オーバー‥‥。{n}自己修復不能‥‥機能‥停止‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0020",
   "jp": "{v:0017}やった、壊れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0021",
   "jp": "{v:0018}みんな大丈夫？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0022",
   "jp": "{v:0019}うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0023",
   "jp": "{v:001D}は、はい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0024",
   "jp": "{v:001C}こちらも、どうにか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0025",
   "jp": "{v:001A}ああ、なんとかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0026",
   "jp": "{v:0025}明らかな敵対行動を感知。{p}{v:0026}これより、安全のためにシステム閉鎖の準備を{n}行います。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0027",
   "jp": "{v:0027}閉鎖って‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0028",
   "jp": "{v:0028}まずいぞ！{n}早く終わらせないと、ここの装置を動かせなくなる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0029",
   "jp": "{v:0029}なんだか知らないけど、まずそうな予感‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen178.0030",
   "jp": "{v:002A}ここの装置を動かせなくなっちゃうよ！{n}急ごう！",
   "en": "",
   "term": "end"
  }
 ]
}
