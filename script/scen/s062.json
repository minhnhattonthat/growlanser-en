  },
  {
   "id": "scen062.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen062.0002",
   "jp": "魔術師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen062.0003",
   "jp": "看守",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen062.0004",
   "jp": "調理人",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen062.0005",
   "jp": "バーンシュタイン王城",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0006",
   "jp": "申し訳ございません。{n}ここから先へはお通しできません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0007",
   "jp": "お疲れさまです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0008",
   "jp": "申し訳ございませんが、{n}ここはお通しできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0009",
   "jp": "もう少し早く駆けつけられれば、{n}私も手を貸せたのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0010",
   "jp": "‥‥私はナイツの名にかけて、市民を守る‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0011",
   "jp": "君たちには頭が上がらないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0012",
   "jp": "後はゲヴェルをなんとかしないとな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0013",
   "jp": "これでゲヴェルの脅威が去った。{n}また元のような平和な世界になるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0014",
   "jp": "私の力が必要か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0015",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0016",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0017",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen062.0018",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen062.0019",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0020",
   "jp": "　{n}　　　　{FFEF}ジュリアンが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0021",
   "jp": "頼りにしてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0022",
   "jp": "早く平和を取り戻したい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0023",
   "jp": "これ以上、国民に不安を与えてはおけぬ。{n}早急に事態を解決せねば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0024",
   "jp": "いろいろとありがとうございました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0025",
   "jp": "あのゲヴェルを倒すなんて、{n}さすが僕が認めた人ですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0026",
   "jp": "ねぇ、エリオット！{n}地下牢にリシャールがいないんだけど、{n}どうしちゃったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0027",
   "jp": "衛兵とおぼしき奴も死んでいたぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0028",
   "jp": "えっ！{n}それは一体‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0029",
   "jp": "陛下！{n}お取り込み中のところ、申し訳ありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0030",
   "jp": "どうしました？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0031",
   "jp": "実は、ライエルがどこにも見あたらないのです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0032",
   "jp": "えっ！？{n}ライエルまで？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0033",
   "jp": "‥‥？{n}他にも誰か‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0034",
   "jp": "地下牢にいた、リシャールもいないんです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0035",
   "jp": "何だって？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0036",
   "jp": "ヴェンツェルを倒すのに{n}リシャールが必要だっていうのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0037",
   "jp": "‥‥何があったのでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0038",
   "jp": "私が調査して参ります。{n}よろしいでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0039",
   "jp": "そうですね。{n}よろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0040",
   "jp": "はっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0041",
   "jp": "嫌な予感がするぜ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0042",
   "jp": "何事もなければ良いのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0043",
   "jp": "リシャールとライエルがいないそうですね。{n}先ほどリーヴスから報告を受けました‥‥。{n}何事もなければ良いのですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0044",
   "jp": "僕の力が必要ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0045",
   "jp": "　{n}　　　　{FFEF}エリオットが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0046",
   "jp": "はりきって行きましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0047",
   "jp": "はやくゲヴェルを倒して、{n}平和な世界を作りたいですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0048",
   "jp": "‥‥いったい、いつになったら{n}平和な世界が来るのでしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0049",
   "jp": "申し訳ございません。{n}ここから先へはお通しできません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0050",
   "jp": "ここへは入れません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0051",
   "jp": "これは、エリオット陛下。{n}ご機嫌うるわしゅう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0052",
   "jp": "この城の至る所には{n}魔法を防ぐような仕掛けがしてあります。{p}回復魔法などなら大丈夫ですが、{n}強い魔力を感知すると、{n}かき消されてしまうことがあります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0053",
   "jp": "申し訳ございません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0054",
   "jp": "扉には鍵がかかっている。{n}どうやら入れないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0055",
   "jp": "ここから先へはお通しできません。{n}お戻り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0056",
   "jp": "　{n}　　　　　　　鍵がかかっている！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0057",
   "jp": "ここは兵士の待機室ですよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0058",
   "jp": "もう少しで交替か‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0059",
   "jp": "ここはお客様用の待合室です。{n}といっても、あなた方には必要ありませんよね。{p}あなた方は特別待遇ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0060",
   "jp": "異常はありません。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0061",
   "jp": "{FFF3}{FFF6}‥‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0062",
   "jp": "{v:003F}元気ないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0063",
   "jp": "{v:0040}ゲヴェルが死んじまったせいだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0064",
   "jp": "‥‥何だ‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0065",
   "jp": "料理は盛りつけまでが芸術なんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0066",
   "jp": "ふんふん♪{n}オイラは～、お城の～♪{n}おかかえ、コック～♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0067",
   "jp": "早く焼けないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0068",
   "jp": "エリオットをよろしくお願いします。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0069",
   "jp": "他人の国へ来ているんだぞ。{n}礼儀を重んじるのも騎士のつとめだ。{p}テレポートを使いたいなら、{n}城の外へ出てからにしろ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen062.0070",
   "jp": "不思議な力でかき消された‥‥",
   "en": "",
   "term": "end"
  }
 ]
}
