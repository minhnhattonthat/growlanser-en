  },
  {
   "id": "scen187.0001",
   "jp": "{FFEE}ルイセを守れ！{FFF1}",
   "en": "{FFEE}Protect Luise!{FFF1}",
   "term": "end"
  },
  {
   "id": "scen187.0002",
   "jp": "{v:0047}どうしてルイセちゃんを狙うの？",
   "en": "{v:0047}Why are you after Luise-chan?",
   "term": "end"
  },
  {
   "id": "scen187.0003",
   "jp": "{v:0048}邪魔なんだよ‥‥。",
   "en": "{v:0048}She's in the way...",
   "term": "end"
  },
  {
   "id": "scen187.0004",
   "jp": "{v:0049}邪魔？",
   "en": "{v:0049}In the way?",
   "term": "end"
  },
  {
   "id": "scen187.0005",
   "jp": "{v:004A}グローシュを持つ者はな！{n}とくにヤツの持つグローシュは強すぎる！",
   "en": "{v:004A}All who possess Grosh are! And hers is far too strong!",
   "term": "end"
  },
  {
   "id": "scen187.0006",
   "jp": "{v:004B}まさか一連のグローシアン狩りはお前の仕業か！",
   "en": "{v:004B}Are you the one behind all these Growsian hunts?!",
   "term": "end"
  },
  {
   "id": "scen187.0007",
   "jp": "{v:004C}さてな！",
   "en": "{v:004C}Who knows?!",
   "term": "end"
  },
  {
   "id": "scen187.0008",
   "jp": "{v:0053}きゃあっ！",
   "en": "{v:0053}Aah!",
   "term": "end"
  },
  {
   "id": "scen187.0009",
   "jp": "{v:0054}そんな‥‥ルイセちゃん！",
   "en": "{v:0054}No... Luise-chan!",
   "term": "end"
  },
  {
   "id": "scen187.0010",
   "jp": "{v:0055}くっくっくっ！{p}{v:0056}これで我々の邪魔をするものはいなくなったぞ！",
   "en": "{v:0055}Heh heh heh!{p}{v:0056}Now no one remains to stand in our way!",
   "term": "end"
  },
  {
   "id": "scen187.0011",
   "jp": "むぅぅ‥‥。{n}無理をしすぎたか‥‥。",
   "en": "Hrrm... Perhaps I pushed myself too hard...",
   "term": "end"
  },
  {
   "id": "scen187.0012",
   "jp": "{v:0057}ぐ‥‥まさか‥{FE1E}‥{FFF9}{FC01}{FE1E}‥{FE1E}‥{FE1E}‥",
   "en": "{v:0057}Ugh... Impossible...{FE1E}...{FFF9}{FC01}{FE1E}...{FE1E}...{FE1E}...",
   "term": "end"
  },
  {
   "id": "scen187.0013",
   "jp": "{v:0058}ふむ‥‥終わったな。",
   "en": "{v:0058}Hmm... It is over.",
   "term": "end"
  },
  {
   "id": "scen187.0014",
   "jp": "{v:004D}ここか？",
   "en": "{v:004D}Is this the place?",
   "term": "end"
  },
  {
   "id": "scen187.0015",
   "jp": "{v:004E}えっ？{n}敵？",
   "en": "{v:004E}Huh? An enemy?",
   "term": "end"
  },
  {
   "id": "scen187.0016",
   "jp": "{v:004F}早とちりするでない。",
   "en": "{v:004F}Now, now, do not jump to conclusions.",
   "term": "end"
  },
  {
   "id": "scen187.0017",
   "jp": "{v:0050}えっ？",
   "en": "{v:0050}Huh?",
   "term": "end"
  },
  {
   "id": "scen187.0018",
   "jp": "{v:0051}お前ほどのグローシュを持つ者を{n}殺させるわけにはいかん。{n}及ばずながら手助けさせてもらうぞ。",
   "en": "{v:0051}I cannot let someone with Grosh as powerful as yours{n}be killed. Allow this old man to offer what help he can.",
   "term": "end"
  },
  {
   "id": "scen187.0019",
   "jp": "{v:0052}くっ！{n}邪魔なじじいめ！",
   "en": "{v:0052}Tch! You meddling old fool!",
   "term": "end"
  }
 ]
}
