   "jp": "アナウンス",
   "en": "Announcer",
   "term": "null"
  },
  {
   "id": "scen166.0002",
   "jp": "決勝戦開始",
   "en": "Final Begins",
   "term": "end"
  },
  {
   "id": "scen166.0003",
   "jp": "{v:0056}いっけーーーっ！",
   "en": "{v:0056}Go get 'eeem!",
   "term": "end"
  },
  {
   "id": "scen166.0004",
   "jp": "{v:0008}もぉ～～！ドジなんだからぁ！",
   "en": "{v:0008}Ughhh! You're such a klutz!",
   "term": "end"
  },
  {
   "id": "scen166.0005",
   "jp": "{v:0053}ごめんなさい！",
   "en": "{v:0053}I'm sorry!",
   "term": "end"
  },
  {
   "id": "scen166.0006",
   "jp": "{v:0054}きゃあっ！",
   "en": "{v:0054}Aah!",
   "term": "end"
  },
  {
   "id": "scen166.0007",
   "jp": "{v:0055}ああっ！ルイセちゃんが！{n}もぅっ！敵討ちよ！",
   "en": "{v:0055}Oh, no! Luise-chan! Grrr! I'll get them for this!",
   "term": "end"
  },
  {
   "id": "scen166.0008",
   "jp": "{v:0048}行くぞ！",
   "en": "{v:0048}Here I come!",
   "term": "end"
  },
  {
   "id": "scen166.0009",
   "jp": "{v:0049}{FFF5}女に剣は振るいたくはないが、勝負となれば仕方ない。{n}覚悟しろ！",
   "en": "{v:0049}{FFF5}I'd rather not raise my sword against a woman, but{n}this is a match. I have no choice. Prepare yourself!",
   "term": "end"
  },
  {
   "id": "scen166.0010",
   "jp": "{v:004A}うぅっ！",
   "en": "{v:004A}Ugh!",
   "term": "end"
  },
  {
   "id": "scen166.0011",
   "jp": "{v:004D}すまない、後は任せたぞ。",
   "en": "{v:004D}Sorry. The rest is up to you.",
   "term": "end"
  },
  {
   "id": "scen166.0012",
   "jp": "{v:004E}任せろ、ゼノス！",
   "en": "{v:004E}Leave it to me, Xenos!",
   "term": "end"
  },
  {
   "id": "scen166.0013",
   "jp": "{v:004F}とうっ！",
   "en": "{v:004F}Hah!",
   "term": "end"
  },
  {
   "id": "scen166.0014",
   "jp": "{v:0051}くっ！{n}やはり強いな‥‥。{p}{v:0052}だが負けるわけにはいかん！",
   "en": "{v:0051}Guh! You're as strong as I thought...{p}{v:0052}But I cannot afford to lose!",
   "term": "end"
  },
  {
   "id": "scen166.0015",
   "jp": "{v:0050}うおぉっ！",
   "en": "{v:0050}Raaagh!",
   "term": "end"
  },
  {
   "id": "scen166.0016",
   "jp": "{v:004B}うぐっ！{p}{v:004C}やはりこんな体じゃ無理か‥‥。",
   "en": "{v:004B}Urgh!{p}{v:004C}I guess I can't manage it in this condition...",
   "term": "end"
  },
  {
   "id": "scen166.0017",
   "jp": "{v:0057}勝負あり！そこまで！",
   "en": "{v:0057}The match is over! That's enough!",
   "term": "end"
  },
  {
   "id": "scen166.0018",
   "jp": "{v:0058}やったぁ！優勝だよ！",
   "en": "{v:0058}Yaaay! We're the champions!",
   "term": "end"
  },
  {
   "id": "scen166.0019",
   "jp": "{v:0059}やったね、お兄ちゃん！",
   "en": "{v:0059}We did it, Big Brother!",
   "term": "end"
  }
 ]
