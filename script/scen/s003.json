  {
   "id": "scen003.0010",
   "jp": "ＬＬＭ魔法教室講師",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen003.0011",
   "jp": "男",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen003.0012",
   "jp": "ローランディア兵隊長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen003.0013",
   "jp": "ローランディア兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen003.0014",
   "jp": "警備兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen003.0015",
   "jp": "王都ローザリア",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0016",
   "jp": "開門！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0017",
   "jp": "これはこれは{s:0000}様。{n}ご活躍の哮は、よく聞いております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0018",
   "jp": "どうぞ、お入り下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0019",
   "jp": "{v:004C}いらっしゃいませ。{n}スキマ屋へようこそ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0020",
   "jp": "{v:0054}これからもスキマ屋をよろしくね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0021",
   "jp": "君たちの活躍は、よく哮になってるよ。{n}もう英雄として大評判だよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0022",
   "jp": "ローランディアにランザック、{n}そして君たちがいれば、{n}インペリアル・ナイツなんて怖くないな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0023",
   "jp": "ようやくノストリッジへの近道が出来たそうだね。{n}うまくすれば、これで戦争も終結出来るかもな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0024",
   "jp": "やっと平和が訪れたのね。{n}でも、この胸騒ぎは何かしら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0025",
   "jp": "いつになったら、平和になるのかしらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0026",
   "jp": "{v:000D}いらっしゃいませ。{n}当店では、様々なグッズを取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0027",
   "jp": "{v:000E}お買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0028",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0029",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0030",
   "jp": "他にもご用はおありですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0031",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0032",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0033",
   "jp": "{v:0018}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0034",
   "jp": "はぁ‥‥。子供の頃が懐かしいわね‥‥。{n}岬ではるか遠くを飛ぶフェザリアンを見た日も、{n}こんな晴れた空だったわ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0035",
   "jp": "グローシアンが行方不明になってるそうじゃない。{p}はあ、どうしよう‥‥。{n}私はグローシアンじゃないけれど{n}このままじゃ不安で、外へ出られないわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0036",
   "jp": "えっ！{n}もう解決したの！{n}よかった～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0037",
   "jp": "城門は堅く閉ざされている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0038",
   "jp": "　{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}売れねぇなぁ{FE1E}‥{FE1E}‥。{FFFB}{n}　‥‥誰も来ねぇし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0039",
   "jp": "　　特売品多数！{n}　　　アイテムショップ・ココ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0040",
   "jp": "　　特売品多数！{n}　　　　スキマ屋",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0041",
   "jp": "マンホールの底には、何もないようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0042",
   "jp": "店の前にあるマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0043",
   "jp": "マンホールがまるい形をしているのは、{n}向きがずれても落ちないためだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0044",
   "jp": "オイラ、すっごい魔法使いになるんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0045",
   "jp": "こいつ、またホラ吹いてるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0046",
   "jp": "ホラじゃないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0047",
   "jp": "うぅ‥‥。{n}なんか寂しいよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0048",
   "jp": "僕たち、デート中なんだ。{n}邪魔しないでくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0049",
   "jp": "僕の彼女、ここを散歩するのが好きだったんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0050",
   "jp": "私たち、デート中なの。{n}邪魔しないで！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0051",
   "jp": "あぁ‥‥。{n}これから私はどうしたらいいの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0052",
   "jp": "妖精ちゃん。{n}あなたも彼と一緒に頑張ってね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0053",
   "jp": "そういえば‥‥、{n}あなたの妹さんって確かグローシアンよね？{p}最近、グローシアンの行方不明者が多いみたいだから{n}気をつけた方がいいわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0054",
   "jp": "あら？{n}あの事件って解決したの。{n}良かったじゃない、妹さんが無事で。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0055",
   "jp": "良かったじゃない、妹さんが無事で。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0056",
   "jp": "{v:0034}本日はお買い求めですか？{n}それともご売却ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0057",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0058",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0059",
   "jp": "他にも何かおありでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0060",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0061",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0062",
   "jp": "{v:003E}ありがとうございました！{n}またどうぞ、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0063",
   "jp": "{v:000C}いらっしゃいませ。{n}当店では、様々な装備品を取り扱っております。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0064",
   "jp": "やっと商店街の営業が始まったよ。{n}後で買い物にでも行こうかな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0065",
   "jp": "‥‥なんて、のんびりしてられないか。{n}今、隣国との戦争まっただ中だもんな‥‥。{p}ったく、なんてことしてくれたんだ。{n}この国のお偉いさんはさ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0066",
   "jp": "やっと商店街へ買い出しに行って来たよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0067",
   "jp": "ごめ～ん。{n}今、手が放せないの。{n}しばらくしたら、また来て。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0068",
   "jp": "あら、あなた達だったの？{n}最近ではもの凄い活躍らしいじゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0069",
   "jp": "デリス村の村長は私の叔父なのよ。{n}今でこそ、ぼ～っとして見えてるけど{n}昔はけっこう切れ者だったらしいわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0070",
   "jp": "‥‥なんか、ず～っと物陰に隠れていると{n}眠くなっちゃうなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0071",
   "jp": "へぇ～。{n}こんな所に出るんだ‥‥。{n}面白いね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0072",
   "jp": "アンタねぇ。{n}王都をウロウロしても、仕方ないでしょ？{n}さっさと家に戻りなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0073",
   "jp": "うす汚れたマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0074",
   "jp": "新しいマンホールだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0075",
   "jp": "　{n}　　　　　南大通り商店街、営業中！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0076",
   "jp": "今では兵隊さんが品物を買いに来て、大忙しだ。{n}ああ、忙しい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0077",
   "jp": "今はちょっと忙しいの。{n}悪いけど、また後にしてくれないかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0078",
   "jp": "頑張るんだよっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0079",
   "jp": "よく、ここへ来る方法がわかったな‥‥。{n}ここに気づいたのは、お前が初めてだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0080",
   "jp": "{v:0019}おう、いらっしゃい。{n}ここは装備品を売ってる店だ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0081",
   "jp": "{v:001B}買いに来たのか？{n}それとも何か売る気か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0082",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0083",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0084",
   "jp": "まだ何か用か？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0085",
   "jp": "・購入",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0086",
   "jp": "・売却",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0087",
   "jp": "{v:0025}じゃあな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0088",
   "jp": "お店の営業が始まってからずいぶん経つのに、{n}何となく賑やかさにかけるのよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0089",
   "jp": "これも、戦争のせいかしらね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0090",
   "jp": "やあ、君たち。{n}頑張って僕らを守ってくれよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0091",
   "jp": "‥‥何か、言い方がカチンとくるんだけど、{n}それは、アタシの気のせい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0092",
   "jp": "そうだよ、君の気のせいだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0093",
   "jp": "‥‥あ、そう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0094",
   "jp": "何か新しい遊びはないかなぁ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0095",
   "jp": "{v:0065}ったく、困ったもんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0096",
   "jp": "　　遊びすぎに注意しましょう！{n}　　～ローランディア子供会～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0097",
   "jp": "このマンホールをくぐると地底都市が！！{FFFB}{n}‥‥ということは絶対にない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0098",
   "jp": "　　　　　　魔法学院合格率６０％！{n}　　　　実績に裏付けされた信頼の進学塾{n}　　　　　　　『ＬＬＭ魔法教室』",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0099",
   "jp": "今日に限って、鉄格子が外れない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0100",
   "jp": "まったく、街中で戦闘なんかするなよ～[01BE]{n}家に帰れないじゃないか[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0101",
   "jp": "誰か、俺に魔法を教えてくれぇ～！{n}しかも親切で分かりやすくないと嫌だ～！{p}‥‥あ、あとタダで教えてくれないと困る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0102",
   "jp": "あ～あ‥‥私の力も何かに役立てられないかな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0103",
   "jp": "あなたに教えることは、もうなさそうね。{p}だけどこのおじいさんは、{n}まだまだ勉強が必要みたい[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0104",
   "jp": "‥‥ふむふむ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0105",
   "jp": "能力の説明で、まだお知りになりたい事は{n}ありますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0106",
   "jp": "だいたいはわかったんじゃが‥‥。{n}１つ聞いてもいいかのぉ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0107",
   "jp": "何でしょう？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0108",
   "jp": "わしも経験をつめば、剣とかを振り回して、{n}きめぽぉずをとるんじゃろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0109",
   "jp": "え‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0110",
   "jp": "わしも経験をつめば、{n}きめぽぉずをとるんじゃろうか？{n}そこがいちばん知りたいのぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0111",
   "jp": "{v:0066}ねぇ、どうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0112",
   "jp": "{v:0067}実はここからノストリッジの戦場まで物資を{n}運ぶのが仕事なのだが、途中で必ずモンスターが{n}襲ってくるので、物資を届けられないのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0113",
   "jp": "{v:0068}それでは前線の補給は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0114",
   "jp": "{v:0069}ほとんど届かず、現地調達をしているのが現状だ。{n}このままでは我が軍は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0115",
   "jp": "{v:006A}これじゃ、戦争で勝つどころか、{n}わたし達も湖まで行けないよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0116",
   "jp": "{v:006B}とはいえ、もう護衛の兵さえいないのだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0117",
   "jp": "{v:006C}もしよかったら、我々の護衛をお願いできないか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0118",
   "jp": "{v:006D}おお、護衛をやってくれるのか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0119",
   "jp": "{v:006E}どうせ、戦線を押し返せなきゃ、{n}目的地にも到達できねぇしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0120",
   "jp": "{v:006F}ではすぐに出発の手配をする。{n}戦場への道のところで落ち合おう！{p}{v:0070}君たちも準備があるなら、今のうちに済ませてくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0121",
   "jp": "ごめんなさい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0122",
   "jp": "いやいや、君たちにも都合があるだろうからね。{p}しかし、無事に物資を送るには、{n}どうすれば‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0123",
   "jp": "この物資を届けなければ、我が軍は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0124",
   "jp": "大変そうねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0125",
   "jp": "ちょっとアンタ、手伝ってあげたら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0126",
   "jp": "おい、こっちからラシェルに向かうと{n}かなりの遠回りになるぞ。{p}今のルイセには時間がない。{n}東から向かおうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0127",
   "jp": "そろそろ、家に帰りなさいよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0128",
   "jp": "{v:0006}おーい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0129",
   "jp": "{v:0007}ねぇ、誰か呼んでるよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0130",
   "jp": "{v:0008}えぇ、ウソ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0131",
   "jp": "‥{FE14}‥{FE14}‥{FE14}。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0132",
   "jp": "{FB00}{v:0009}お兄さまそっくり！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0133",
   "jp": "‥‥{v:000A}やっぱりそうなのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0134",
   "jp": "{v:000B}何が『やっぱりそうか』なの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0135",
   "jp": "{v:000C}突然で失礼。{p}{v:000D}私はラルフという者だ。{n}私は生まれて間もなく生き別れとなった双子の弟を{n}探している。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0136",
   "jp": "{v:000E}双子の‥‥弟？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0137",
   "jp": "{v:000F}そうだ。{n}街の中で彼を見かけ気になって追ってきたのだが‥‥。{p}{v:0010}見れば見るほど似ている‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0138",
   "jp": "{v:0011}そんなに似ているのか？{n}俺には知る方法がないからな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0139",
   "jp": "{v:0012}似てるなんてモンじゃないよ！{n}まるで同じ人間だよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0140",
   "jp": "{v:0013}ちょっと、蹴ってみてイイ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0141",
   "jp": "{v:0014}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0142",
   "jp": "{FB00}{v:0015}もう、ティピったら‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0143",
   "jp": "{v:0016}ああ、ウソウソ、じょ～だん！{n}蹴り心地も同じかなって、思ったから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0144",
   "jp": "{v:0017}でも本当にそっくりだねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0145",
   "jp": "{v:0018}それが双子の証明になるだろ？{p}{v:0019}ひょっとして君、誰かに育てられたとか、{n}そういったことはないかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0146",
   "jp": "{v:001A}確かにお兄ちゃんは、{n}お母さんに引き取られて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0147",
   "jp": "{v:001B}疑う余地もないわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0148",
   "jp": "{v:001C}どうだろう、やっと肉親と会えたんだ、{n}こんなところで立ち話じゃなく、{n}街に戻ってゆっくり話さないか？{p}{v:001D}実は宿を取ってあるんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0149",
   "jp": "{v:001E}どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0150",
   "jp": "ラルフと宿に行きますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0151",
   "jp": "・みんなに任せる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0152",
   "jp": "・行く",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0153",
   "jp": "・行かない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen003.0154",
   "jp": "{v:001F}何を遠慮しているんだ。{n}俺たちに気遣う必要なんてないぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0155",
   "jp": "{v:0020}そうだよ、お兄ちゃん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0156",
   "jp": "{v:0021}決まりだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0157",
   "jp": "{v:0022}慌てて追いかけてきた甲斐があったよ。{n}さあ、行こう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0158",
   "jp": "岬へ行かれるのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0159",
   "jp": "仲間と力を合わせて頑張って下さい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0160",
   "jp": "ここはローランディア王国の王都、ローザリアです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0161",
   "jp": "街の外に出るのですか？{n}どうか気を付けて。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0162",
   "jp": "申し送り中ですので、{n}邪魔をしないで下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0163",
   "jp": "一時も気を抜けないな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0164",
   "jp": "ゆっくり休ませてもらうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0165",
   "jp": "　{n}　　『出かけるときは、戸締まりを忘れずに！』{n}　　　　　　　～ローザリア警備隊～",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0166",
   "jp": "ほら！{n}マスターに報告、報告！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0167",
   "jp": "{v:0014}なんとか市民は守りきったようですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0168",
   "jp": "{v:0015}まったく、王都にまで攻め込んでくるなんて‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0169",
   "jp": "{v:00DB}ルイセちゃんの力がなくなったことが{n}バレちゃったからかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0170",
   "jp": "{v:0016}ルイセ君のグローシュが弱っていることを{n}知られたからか‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0171",
   "jp": "{v:0017}ルイセちゃんのグローシュが弱ってると{n}知られてしまいましたからね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0172",
   "jp": "{v:0018}ルイセの力がなくなってるって知られちまったしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0173",
   "jp": "{v:0019}ルイセさんのグローシュが弱っていることも{n}知られてしまいましたし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0174",
   "jp": "{v:001A}ルイセのグローシュが弱くなっていることも{n}原因だろうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0175",
   "jp": "{v:001B}ルイセのグローシュが弱っていることを{n}気づかれたからだろうな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0176",
   "jp": "{v:001C}ここの整理は他の者に任せて、家に戻りましょう。{n}あなたたちの報告を聞かせてください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0177",
   "jp": "　{n}　　　　　{FFEF}サンドラが同行者になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0178",
   "jp": "ふぅ‥‥。{n}商品が無事でよかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0179",
   "jp": "もうダメかと思いましたよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0180",
   "jp": "し、死ぬかと思った‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0181",
   "jp": "た、助かったのね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0182",
   "jp": "か、彼が‥‥。{n}どうして、こんな事になるの‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0183",
   "jp": "び、びっくりしたぁ～～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0184",
   "jp": "あれ‥‥。{n}弟はどこに行ったの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0185",
   "jp": "すっげ～！{n}お兄ちゃん達って強いんだね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0186",
   "jp": "あれ？{n}お兄ちゃんとはぐれちゃったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0187",
   "jp": "ふぅ‥‥。{n}見つかったら、どうしようかと思っちゃった。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0188",
   "jp": "あなた方がいなかったらと思うと、{n}ぞっとします。{n}本当に助かりました。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0189",
   "jp": "何なんだ、あの化け物は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0190",
   "jp": "さすがアルカディウス王に認められた騎士様ですね。{n}あの化け物を退治してしまうとは、さすがです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0191",
   "jp": "奴ら、どこから現れたんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0192",
   "jp": "来るなら来い、化け物め！{n}ここを通しはしないぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0193",
   "jp": "ここは私たちが守ります！{n}この命に代えても！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0194",
   "jp": "現在この門は閉鎖中です！{n}街の中からくせ者がいなくならない限り、{n}開けられません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0195",
   "jp": "怪物が街の東地区で暴れているんだって！{n}あなたも家に戻った方がいいわよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0196",
   "jp": "　{FE1E}‥{FE1E}‥{FE1E}‥{FE1E}化け物かぁ{FE1E}‥{FE1E}‥。{FFFB}{n}　‥‥化け物でもいいから、買いに来ねぇかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0197",
   "jp": "{v:0033}いらっしゃいませ。{n}この店では、様々なグッズをお買い求めいただけます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0198",
   "jp": "どこへ行こうというのです？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0199",
   "jp": "{FFEC}ティピちゃーん、きーっく{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0200",
   "jp": "マスターを連れだして、どこへ行くつもりよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0201",
   "jp": "‥‥なるほど、こういうことをしていたのですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0202",
   "jp": "‥‥‥{FB00}あ‥‥[01BE]",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0203",
   "jp": "せっかくお兄さんと再会できたんだから、{n}もうちょっとゆっくりしていこうよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0204",
   "jp": "　{n}『{FFEF}大きなコイン{FFF1}』を手に入れた！{FFFB}{n}と思ったら、ただのマンホールだった！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0205",
   "jp": "マンホールのふたは、雨の日によく滑る。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0206",
   "jp": "マンホールのふたは{n}４０キログラムと、かなり重い。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0207",
   "jp": "　　　スターロード武器・防具店{n}　　　　　　　王都ローザリア本店",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen003.0208",
   "jp": "マスターをどこへ連れ出す気よ！",
   "en": "",
   "term": "end"
  }
 ]
}
