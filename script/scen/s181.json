  {
   "id": "scen181.0001",
   "jp": "盗賊",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen181.0002",
   "jp": "ランザック兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen181.0003",
   "jp": "{FFEE}ランザック兵を救え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0004",
   "jp": "{v:0028}おい！{n}そいつらは俺たちが倒す！{n}街の中に下がっていろ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0005",
   "jp": "{v:0029}断る！{p}{v:002A}今まで殺された仲間の仇を討つ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0006",
   "jp": "{v:002B}チッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0007",
   "jp": "お、親分。{n}もう、俺ダメ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0008",
   "jp": "こんなはずじゃ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0009",
   "jp": "へっへっへっ‥‥。{n}今まで人を殺しすぎた罰が当たったのかな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0010",
   "jp": "くそっ！{n}こいつら、人を殺しなれてやがる‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0011",
   "jp": "正規兵の俺が、賊ごときに‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0012",
   "jp": "{v:0030}ああっ！{n}ランザックの兵隊さんがっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0013",
   "jp": "{v:0031}き、貴様ら！{n}よくも我が部下を！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0014",
   "jp": "{v:0032}ち、違うの、これは‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0015",
   "jp": "{v:0033}問答無用！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0016",
   "jp": "{v:002C}やるじゃねぇか‥‥。{p}{v:002D}だが、まだやられるわけにはいかねぇんだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0017",
   "jp": "{v:002E}あっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen181.0018",
   "jp": "‥‥{v:002F}逃げられちゃった‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
