  {
   "id": "scen146.0002",
   "jp": "休暇デバッグ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen146.0003",
   "jp": "文官に話しかけると、デバッグ開始。{n}ここではセーブできます。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen146.0004",
   "jp": "今回の休暇日数を設定して下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen146.0005",
   "jp": "・３日",
   "en": "",
   "term": "end",
