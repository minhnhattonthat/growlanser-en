  {
   "id": "scen185.0001",
   "jp": "{FFEE}村人を脱出させろ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0002",
   "jp": "{v:007E}うわぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0003",
   "jp": "{FB00}{v:007F}１体、１体は弱いが、数で迫られると不利になる。{n}{FB00}注意して戦うんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0004",
   "jp": "{v:0080}アタシ達のことはいいから、先に逃げて！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0005",
   "jp": "{v:0081}あ、ありがとうございます！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0006",
   "jp": "あとは、ここの怪物をやっつければ、{n}おっけーだね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0007",
   "jp": "{v:005E}ぐわぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0008",
   "jp": "{v:005F}ぎゃああっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0009",
   "jp": "{v:0007}バカバカバカ！{n}なにやってんのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0010",
   "jp": "{v:0082}もう残っている卵もないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0011",
   "jp": "{v:0083}村の人も無事だったしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen185.0012",
   "jp": "{v:0084}さ、もうここは大丈夫だって、{n}村長さんに教えてあげようよ。",
   "en": "",
   "term": "end"
  }
