 "entries": [
  {
   "id": "scen025.0000",
   "jp": "",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen025.0001",
   "jp": "魔法学院生徒",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen025.0002",
   "jp": "ニック",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen025.0003",
   "jp": "教授",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen025.0004",
   "jp": "魔法学院",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0005",
   "jp": "{v:0000}あ、お兄さま、いらっしゃいませ！{n}今日は何のご用ですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0006",
   "jp": "{v:0001}別にアンタに用があって来たんじゃないわよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0007",
   "jp": "{v:0002}あのね、魔法実習が終わったから、{n}その終了証明書を院長先生に届けるようにって。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0008",
   "jp": "{v:0003}えぇっ！{n}ルイセちゃん、もう実習終わったの？{p}{FC03}{v:0004}うぅ～、また差を付けられちゃった‥‥。{p}{FC02}{v:0005}こうなったら、{n}アタシもルイセちゃんを見習わないとっ！{p}{FC00}{v:0006}見習うためにはルイセちゃんのそばにいなきゃ！{p}{FC06}{v:0007}というわけで、しばらくやっかいになりま～す！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0009",
   "jp": "　{n}　　　　{FFEF}ミーシャが無理矢理仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0010",
   "jp": "メンバーが多すぎます。{n}１人外してください。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0011",
   "jp": "どちらをパーティーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0012",
   "jp": "・アリオスト",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0013",
   "jp": "・カレン",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0014",
   "jp": "アリオストの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0015",
   "jp": "{v:0008}ごめんなさい、アリオストさん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0016",
   "jp": "{v:0009}ああ、気にしないでくれ。{n}君のためなら、おやすいごようさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0017",
   "jp": "{v:000A}アタシ、しっかり勉強します！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0018",
   "jp": "カレンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0019",
   "jp": "{v:000B}せっかくここまで来たからアイリーンさんに{n}会いたかったけど、ミーシャちゃんのためだもの、{n}また今度にするわ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0020",
   "jp": "{v:000C}ごめんなさい、カレンさん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0021",
   "jp": "{v:000D}そのかわり、しっかりお勉強してね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0022",
   "jp": "{v:0000}アイリーンさん、大丈夫かな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0023",
   "jp": "{v:0001}そりゃ、行ってみなきゃわからんな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0024",
   "jp": "‥‥{v:0002}ここ、どこ？{n}何するとこ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0025",
   "jp": "{v:0003}何言ってるのよルイセちゃん！{n}ここはアタシたちが勉強してる魔法学院じゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0026",
   "jp": "{v:0004}この学院のことを忘れてしまったのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0027",
   "jp": "{v:0005}さっきから気になってたんだけど、あなた達‥‥誰？{n}お兄ちゃんのお友だち？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0028",
   "jp": "{v:0006}ルイセ君‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0029",
   "jp": "{v:0007}そんな！{n}アタシたちのこと忘れちゃったのぉ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0030",
   "jp": "{v:000B}えーー！？{n}ひどいよ、ルイセちゃん！{n}親友だって言ってくれたじゃない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0031",
   "jp": "{v:000A}ルイセ君、僕を忘れてしまったのかい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0032",
   "jp": "{v:000C}ここはルイセちゃんが通ってた魔法学院じゃない！{p}{v:000D}まさか、ミーシャもアリオストさんのことも{n}覚えてないの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0033",
   "jp": "{v:000E}ん？{n}‥‥誰、それ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0034",
   "jp": "{v:000F}グローシュを奪われた後遺症か？{p}‥‥{v:0010}急いだ方がいいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0035",
   "jp": "{v:0009}さっきから気になってたんだけど、{n}あなたは‥‥誰ですか？{n}お兄ちゃんのお友達？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0036",
   "jp": "{v:0008}う‥う～ん‥‥。{n}‥‥ごめんなさい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0037",
   "jp": "学院長の秘書なら西の方へ向かったけど。{n}あの美人秘書がどうしたの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0038",
   "jp": "ここは研究に向いてていいよね～。{n}グローシアン遺跡やフェザリアン遺跡が{n}そばにあるし、水晶鉱山もそこそこ近いし。{p}それにローランディアとバーンシュタインの{n}国境沿いでもあるから、学院の立地条件としては{n}まさに最高って感じだな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0039",
   "jp": "私は薬学を専攻しているから、{n}メディス村とラシェルにしか、用はないけどね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0040",
   "jp": "この前、効能の研究だって、{n}コムスプリングスへ遊びに行ってなかったっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0041",
   "jp": "失礼ね！{n}温泉だって、立派な研究対象よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0042",
   "jp": "机にかじりつくだけが学問ではないと思うの。{n}やっぱり外に出ていろいろな経験を積まないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0043",
   "jp": "って言うかさ～。{n}魔法の才能がある人間を押し込めて、{n}管理してるんじゃないの？{p}教授とかもさ～、アブナイ奴いるからな～。{n}ま、俺は魔法の勉強が出来ればいいや。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0044",
   "jp": "やっとの思いで、学院に入ったのはいいけど、{n}勉強、勉強の毎日だ‥‥。{n}ああ、青春の日々が過ぎてゆく～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0045",
   "jp": "ん？{n}最近、よく見かける顔だな。{n}まさかここの学生じゃないよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0046",
   "jp": "{v:0085}アイリーンさんはどうしているかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0047",
   "jp": "{v:0086}ちょっと会ってみたかったね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0048",
   "jp": "ああ、アイリーンさんは大丈夫でしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0049",
   "jp": "何としてでも、ホールの中を調べたいところだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0050",
   "jp": "俺って卒業できるのかな～？{n}村では一番だったけど、入ってみると{n}すごい奴ばっかりだし。{p}‥‥すっかり自信なくしたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0051",
   "jp": "え？{n}君はもう実習が終わってる？{n}あとは卒業研究だけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0052",
   "jp": "いいなぁ～‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0053",
   "jp": "俺って卒業できるのかな～？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0054",
   "jp": "魔法学院で培ってきた力が{n}人々の役に立てばいいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0055",
   "jp": "とうとう戦乱の世の中になってしまったか‥‥。{n}魔法学院で培ってきた力が役に立てばいいんだけど。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0056",
   "jp": "あ～あ‥‥もっと魔水晶が手に入らないかな。{n}水晶鉱山がもっと発見されれば、{n}こんな悩みは解消されるんだけどな～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0057",
   "jp": "私の友達がアリオストさんの研究室の方に行ったけど、{n}何してるのかしら、彼？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0058",
   "jp": "‥‥{v:0038}あっ、感じる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0059",
   "jp": "{v:0039}どうしたの、ルイセちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0060",
   "jp": "{v:003A}これはゲヴェルの波動‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0061",
   "jp": "{v:003B}方角はここから‥‥。{p}{FFF3}‥‥{FFF4}{FC02}{v:003C}あっ！{n}先に、バーンシュタインの王都へ急ぎましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0062",
   "jp": "{v:003D}え？{n}どうしたのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0063",
   "jp": "{v:003E}王都がどうかしたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0064",
   "jp": "{v:003F}あの、仮面の男たちが、攻撃してる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0065",
   "jp": "{v:0040}そんな！？{n}僕が城を開けているうちに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0066",
   "jp": "{v:0041}いくらインペリアル・ナイツがいるといえど、{n}あの仮面の男たち相手では分が悪い。{n}それにいつゲヴェルが出てくるか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0067",
   "jp": "{v:0042}急いだほうがよさそうだな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0068",
   "jp": "バーンシュタインが危ない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0069",
   "jp": "おや、君たちは‥‥。{n}この前は、ありがとう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0070",
   "jp": "ニックさん‥‥。{n}アイリーンさんに会いに来たのですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0071",
   "jp": "ニックか？{n}アイリーンに会いに来たのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0072",
   "jp": "あぁ。{n}彼女が欲しがっていた薬草が手に入ったのでね。{n}差し入れと一緒に、持ってきたんだ。{p}それで学院長か副学院長に、{n}彼女に会う許可をもらおうと思っているところさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0073",
   "jp": "ふ～ん。{n}でも、２人とも、７階にはいなかったわよ。{n}それに副学院長はメディス村にいるかも。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0074",
   "jp": "そうか。{n}じゃあ、とりあえず校舎を探してみるよ。{p}君たちも、学院長か副学院長を見かけたら{n}僕に教えてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0075",
   "jp": "アイリーンさん、元気にしてるかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0076",
   "jp": "アイリーンさん、元気にしてるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0077",
   "jp": "そうだね。{n}遊びに行ってみようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0078",
   "jp": "だが、多目的ホールに入るには、許可が必要だ。{n}今は無理だな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0079",
   "jp": "うるさい見張りがいなければいいのにね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0080",
   "jp": "グローシアンを狙っている奴がいるんだ。{n}それは仕方ないだろう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0081",
   "jp": "学院のどこかに、保護されているはずだが‥‥。{n}一体、どこだろうな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0082",
   "jp": "多目的ホールじゃないかな？{n}しばらく、何にも使ってなかったし‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0083",
   "jp": "あっ！{n}ニックさんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0084",
   "jp": "やあ、君たちか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0085",
   "jp": "アイリーンさんに会いに来たの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0086",
   "jp": "その通りさ。{n}それで、ホールに入る許可をもらおうと、{n}責任者を捜しているんだが、見つからなくてね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0087",
   "jp": "アイリーンさんに会う許可は、もらえましたか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0088",
   "jp": "アイリーンに会う許可はもらえたのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0089",
   "jp": "‥‥責任者が見つからなくてね。{n}今度は校庭を探してみようかと思って{n}外に出たところさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0090",
   "jp": "それが、ちょっと気になる事があるのよ。{n}多目的ホールから、人の気配がしないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0091",
   "jp": "何だって！？{n}それは一体‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0092",
   "jp": "とにかく、僕は僕で何とかしてみる。{n}君たちも、アイリーンの事がわかったら、{n}僕に教えてくれ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0093",
   "jp": "とにかく、何とか探し出さないとな‥‥。{n}それじゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0094",
   "jp": "{v:0000}ただいま戻りました、先生。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0095",
   "jp": "{v:0001}ご苦労さま。{n}それで、どうだったかね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0096",
   "jp": "{v:0002}やっぱり先生のおっしゃるとおりです。{n}グローシュの放出量が増えているようです。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0097",
   "jp": "‥‥{v:0003}そうか‥‥。{FFF9}{FFFB}{n}{v:0004}出来たら、思い過ごしであって欲しかったが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0098",
   "jp": "‥‥{v:0005}あの、どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0099",
   "jp": "{v:0006}おお、ルイセ君か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0100",
   "jp": "{v:0007}何だか、深刻そうですが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0101",
   "jp": "‥‥{v:0008}うむ。{p}{v:0009}実は『歪み計』が異常な歪みを検出してな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0102",
   "jp": "{v:000A}歪み計ってなんだっけ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0103",
   "jp": "{v:000B}この世界が、２つの世界を重ねているって話は{n}ずっと前にしたことあったよね？{n}その重なりのずれを計る装置のこと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0104",
   "jp": "{v:000C}あ、屋上にあったやつだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0105",
   "jp": "{v:000D}この歪み量は自然のものとも思えんのだ。{p}{v:000E}何か悪いことが起きなければいいのだが‥‥。{p}{v:000F}とにかく、観測を怠らずに慎重に調べてみる。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0106",
   "jp": "{v:0010}がんばって下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0107",
   "jp": "元々別の世界を、無理矢理重ねている世界だからな。{n}このような状況も予想はされるのだが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0108",
   "jp": "野外授業の説明をしているんだ。{n}邪魔をしないでくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0109",
   "jp": "え？{n}学院長の秘書さん？{n}きれいな人だよね！{p}さっき正門の方へ歩いていったよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0110",
   "jp": "この世界はどうなってしまうんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0111",
   "jp": "ふう、死ぬかと思った‥‥。{n}やっぱり単位欲しさにブレーム火山へ行ったのは{n}間違いだったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0112",
   "jp": "まさか、世界が分かれるなんて事は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0113",
   "jp": "教室で講義を聴くより、{n}実践で覚える方が向いているみたい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0114",
   "jp": "あ、お兄さま。{n}アタシの力が必要なんですね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0115",
   "jp": "どうするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0116",
   "jp": "・ミーシャをメンバーに加える",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0117",
   "jp": "・今はメンバーに加えない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0118",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0119",
   "jp": "僕が外れるしかないね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0120",
   "jp": "{s:FFED}をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0121",
   "jp": "誰をメンバーから外しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0122",
   "jp": "・{s:FFED}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0123",
   "jp": "・{s:FFEE}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0124",
   "jp": "{s:FFED}の装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0125",
   "jp": "　{n}　　　　　　{FFEF}ミーシャが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0126",
   "jp": "アタシ、がんばっちゃうね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0127",
   "jp": "ちょっとガッカリ‥‥。{p}{FC00}でも、でも！{n}ご用があったら、いつでもどうぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0128",
   "jp": "人間の力なんて、ちっぽけなものね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0129",
   "jp": "ううっ、ひっく‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0130",
   "jp": "何で私たちがこんな目に‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0131",
   "jp": "怖いわ、私‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0132",
   "jp": "ねえ、学院長の秘書ってさ、全然愛想がないよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0133",
   "jp": "あ、それ私も思った。{n}私、あの人が笑ったところとか見たこと無いよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0134",
   "jp": "あ、それアタシも！{n}というかさ～、{n}無表情以外の表情ってしたことあるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0135",
   "jp": "ないと思うわよ～。{p}あの人も表情変えればもっと美人に見えるのにね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0136",
   "jp": "‥‥それって表情変えなくても美人ってことよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0137",
   "jp": "どうして、あんなに愛想ないのかしらね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0138",
   "jp": "ほんとよね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0139",
   "jp": "はぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0140",
   "jp": "ねえ、聞いた？{n}学院長ってさ、裏でかなり酷いことしてたらしいよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0141",
   "jp": "あ、聞いた聞いた。{n}学院に来たグローシアンがいなくなったのって、{n}学院長の仕業だって哮じゃない？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0142",
   "jp": "ヒドイ話よね～。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0143",
   "jp": "ホント、人間ってうわべだけで信じちゃだめね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0144",
   "jp": "うん、うん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0145",
   "jp": "{v:0092}なんだ、お前たち。{n}まだ用があるのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0146",
   "jp": "{v:0093}何言ってんのよ！{n}中のグローシアンの人たち、{n}いなくなってるじゃないの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0147",
   "jp": "{v:0094}そんな、バカな！{n}ここからは誰も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0148",
   "jp": "{v:0095}やっぱり、あっちから、らしいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0149",
   "jp": "すまないが、学院長か副学院長にこのことを{n}伝えてくれないか？{p}自分はここで、{n}現場が荒らされないように見張っているから。{p}頼んだぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0150",
   "jp": "ここで見たことは、しばらくの間、{n}内密にして欲しいとのことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0151",
   "jp": "{v:000E}ここにはグローシアンの方々が保護されて{n}おられるのだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0152",
   "jp": "{v:000F}知り合いがいるんですけど、{n}会わせていただけないでしょうか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0153",
   "jp": "{v:0010}中にアイリーンさんって知り合いがいるんだけど、{n}会わせてくれる？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0154",
   "jp": "{v:0011}自分には許可を与える権利はない。{n}中の人に会いたければ、学院長か副学院長に許可を{n}もらうことだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0155",
   "jp": "{v:0012}ちぇっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0156",
   "jp": "{v:0013}なんだ、また来たのか。{n}何度来ようと、会わせるわけにはいかん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0157",
   "jp": "‥‥{v:0014}ケチッ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0158",
   "jp": "{v:0015}仕事だからな。{p}{v:0016}それにしても、最近中が静かだな。{n}そう思わんか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0159",
   "jp": "{v:0017}アタシたちにわかるわけないでしょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0160",
   "jp": "{v:0018}それもそうだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0161",
   "jp": "このホールは閉鎖されている。{n}立入許可の無い者は、{n}この中へ入ることはできん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0162",
   "jp": "おい、警備兵から{n}できるだけ離れて使った方がいいぜ。{n}バレないようにな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0163",
   "jp": "{FFEC}ティピちゃーん、きーっく{FFED}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0164",
   "jp": "{v:0027}ん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0165",
   "jp": "{v:00EF}何だ、今の音は？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0166",
   "jp": "{v:0028}お約束はしないの！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0167",
   "jp": "{v:0058}ここって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0168",
   "jp": "{v:0059}校庭の隅だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0169",
   "jp": "{v:005A}ここから大きな箱が運び出されたっていってたよね？{n}それじゃ、その中身って‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0170",
   "jp": "{v:005B}たぶんその通りだ。{p}{v:005C}徐々に見えてきたな。{n}もう一息だ。{n}がんばろうぜ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0171",
   "jp": "‥‥（びっくりしたなぁ、ドキドキ）‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0172",
   "jp": "{v:0083}学院長か副学院長の許可がなければ入れないホール。{n}それから、地下にある専用の研究室‥‥。{p}{v:0084}なんだかにおうわね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0173",
   "jp": "内側からカギをかけられているようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0174",
   "jp": "中へ入ってみたんだけど‥‥。{n}怖くなって途中で引き返して来ちゃったよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0175",
   "jp": "君たちがここを開けてくれたおかげで、{n}やっと中に入れるよ。{n}ありがとう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0176",
   "jp": "{v:005F}う～ん‥‥。{n}開かないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0177",
   "jp": "{v:0060}どうしたんですか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0178",
   "jp": "{v:0061}この前の夜に、ここで知らない男たちが{n}箱を出し入れしてるのを見たんだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0179",
   "jp": "{v:0062}箱？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0180",
   "jp": "{v:0063}ああ。大人が入れそうな大きな木箱だったよ。{n}それも１つじゃなかったんだ。{p}{v:0064}それで何を運び出したのか興味があって‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0181",
   "jp": "{v:0065}だが鍵がかかっていて入れない、と。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0182",
   "jp": "{v:0066}そうなんだ。{p}{v:0067}しかたない。あきらめるとするか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0183",
   "jp": "{v:0078}ああ、あんた達か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0184",
   "jp": "{v:0079}まだここを開けようと思ってるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0185",
   "jp": "{v:007A}内側から鍵がかかってるから、{n}無理だと思うけどね。{n}やっぱり気になるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0186",
   "jp": "‥う～ん‥‥{n}‥‥あの薬を使えれば、姿を見られずに‥‥{n}‥‥‥ブツブツ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0187",
   "jp": "{v:0082}それじゃ、僕はこのへんで。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0188",
   "jp": "{v:007B}そういえば、ここから運び出された箱だが、{n}どこに持って行かれたかわかるか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0189",
   "jp": "{v:007C}あれ、言わなかったっけ？{p}{v:007D}校内に持ち込まれたんだけど、{n}どこにも見あたらないんだ。{n}となるとおそらく地下だね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0190",
   "jp": "{v:007E}地下？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0191",
   "jp": "{v:007F}ってことは、上級職員用研究室だね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0192",
   "jp": "{v:0080}なんなの、その『上級職員』って？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0193",
   "jp": "{v:0081}おじさま達。{n}つまり、学院長と副学院長のことだよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0194",
   "jp": "{v:0068}なんだか怪しいな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0195",
   "jp": "{v:0069}そうねぇ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0196",
   "jp": "{v:006A}最近静かになったホール。{n}運び出された大きな箱。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0197",
   "jp": "{v:006B}アンタ、箱の中に何が入ってたと思う？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0198",
   "jp": "箱の中には何が入っていたと思いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0199",
   "jp": "・財宝",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0200",
   "jp": "・人間",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0201",
   "jp": "・書類",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen025.0202",
   "jp": "{v:006C}財宝かぁ‥‥。{p}{v:006D}だからこっそり運び出していたんですね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0203",
   "jp": "{v:001D}人間っていうと、やっぱり‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0204",
   "jp": "{v:006E}グローシアンしかねぇだろうな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0205",
   "jp": "{v:006F}書類かぁ‥‥。{p}{v:0070}たしかに学校には、{n}たくさんの書類がありますからねぇ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0206",
   "jp": "{v:0071}だーーーっ！{n}どうしてこの会話の流れでそうなるのよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0207",
   "jp": "{v:0072}最近静かになったグローシアンのホール。{n}大人が入れるくらいの箱。{p}{v:0073}そうしたら、中にグローシアンが入ってたって{n}考えるのが自然だよね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0208",
   "jp": "{v:0074}でも、何のために？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0209",
   "jp": "{v:0075}とにかく、徹底的に調べてみる必要があるな。{p}{v:0076}そのためにも、何とかしてホールに入らねぇと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0210",
   "jp": "{v:0077}警備員に見つからないで中に入る方法って{n}なんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0211",
   "jp": "アリオストの研究室",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0212",
   "jp": "どうしたんだい？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0213",
   "jp": "あの‥‥、{n}ミーシャを探してるんですけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0214",
   "jp": "う～ん‥‥。{n}学院内では見かけなかったなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0215",
   "jp": "そうですか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0216",
   "jp": "ん？{n}僕の力が必要なのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0217",
   "jp": "アリオストを仲間に加えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0218",
   "jp": "{v:002A}お、お兄さま！{n}アタシを捨てちゃイヤ～！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0219",
   "jp": "{v:002B}それでは私が外れましょう。{n}ミーシャちゃん、しっかりお勉強してね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0220",
   "jp": "{v:002C}はい。{n}しっかり勉強します！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0221",
   "jp": "カレンの装備品を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0222",
   "jp": "それでは私が外れましょう。{n}ミーシャちゃんのこと、お願いしますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0223",
   "jp": "ゼノスさん‥‥。{n}頑張って下さいね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0224",
   "jp": "でもこれ以上は多すぎるよ。{n}誰かを仲間から外さないと。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0225",
   "jp": "　{n}　　　　　　{FFEF}アリオストが仲間になった！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0226",
   "jp": "ありがとう、がんばるよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0227",
   "jp": "僕の力が必要になったら、{n}いつでも声をかけてくれ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0228",
   "jp": "でも、エリオット君は外せないから‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0229",
   "jp": "うぅ‥‥、{n}アタシが外れるしかないんですね‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0230",
   "jp": "では、私が外れますね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0231",
   "jp": "仕方ねぇ‥‥。{n}俺が抜ければいいんだろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0232",
   "jp": "‥‥頼む。{n}カレンの仇がとりたいんだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0233",
   "jp": "ここって、いろんな物があるんですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0234",
   "jp": "面白いですね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0235",
   "jp": "薬草の本もあるのかしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0236",
   "jp": "{v:004B}さっきの話が本当だったら、お兄さまも‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0237",
   "jp": "{v:004C}さっきの話が本当だとすると、彼も‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0238",
   "jp": "{v:004D}今の話が本当なら、彼は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0239",
   "jp": "{v:004E}こいつもリシャール同様、{n}作られた存在って事になるな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0240",
   "jp": "{v:004F}まさか、作られた‥‥？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0241",
   "jp": "{v:0051}作られた存在か、それともエリオットのように本人か。{n}どうも、ややこしくなってきたな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0242",
   "jp": "{v:0052}と、とにかく！{n}今はルイセちゃんを治すことが先じゃない？{n}ね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0243",
   "jp": "{v:0053}わたしを治すの？{n}‥‥どっか壊れちゃったのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0244",
   "jp": "{v:0011}な、何だお前たちは！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0245",
   "jp": "{v:0012}お前たちのしている研究は、{n}我々に害を及ぼしそうなのでな‥‥。{n}この施設を破壊する。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0246",
   "jp": "{v:0013}そ、そんなことさせるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0247",
   "jp": "{v:0014}おい、この声は‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0248",
   "jp": "{v:0015}大変だよ！{n}あの仮面の男たち、学院を壊すつもりよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0249",
   "jp": "{v:0016}そんなことさせないよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0250",
   "jp": "{v:0017}そんなことさせるか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0251",
   "jp": "{v:0018}ここの学生じゃ、連中には勝てねぇ！{n}俺たちで奴らを倒すんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0252",
   "jp": "奴ら、いったい何なんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0253",
   "jp": "くそっ！{n}許せねぇよ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0254",
   "jp": "こ、怖かった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0255",
   "jp": "{v:0087}あっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0256",
   "jp": "{v:0088}どうしたの、ティピ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0257",
   "jp": "{v:0089}ちょっと待って！{p}‥‥{v:008A}うん、みんなここにいるけど。{n}どうしたの、マスター？{p}{FFF3}‥‥‥。{p}{FC02}{FFF4}{v:008B}えぇっ！？{n}バーンシュタイン軍がランザック王国に？{p}‥‥{v:008C}うん、わかった。{n}ちゃんと伝えるから！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0258",
   "jp": "{v:008D}バーンシュタイン軍が進行を開始したのか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0259",
   "jp": "{v:008E}うん！{n}それで、ランザック王国から応援要請が{n}出てるんだって。{p}{FC03}{v:008F}もしアタシたちも行けたら、行くようにって、{n}言われちゃったんだけど‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0260",
   "jp": "{v:0090}どうしよう、お兄ちゃん？{n}いなくなったアイリーンさんたちを探すのと、{n}ランザック王国の応援と、どっちにするの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0261",
   "jp": "{v:0091}どうするかはお前に任せる。{n}ただ、ランザックに向かうなら時間はないぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0262",
   "jp": "お兄ちゃん、ダメだよ！{n}もう透明になる薬はないんだよ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0263",
   "jp": "とにかく、ホールの中を{n}徹底的に探しましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen025.0264",
   "jp": "あのね、お兄ちゃん。{n}学院の施設内で魔法を使うと、{n}怒られちゃうんだ‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
