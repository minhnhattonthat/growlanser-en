   "term": "null"
  },
  {
   "id": "scen183.0001",
   "jp": "行け、ユングども！{n}お前たちは奴らを食い殺せ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0002",
   "jp": "俺は入り口に{FFEF}マジックロック{FFF1}をかける！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0003",
   "jp": "{v:001F}マジックロック！？{p}{v:0020}そんなのかけられちゃったら、{n}わたし、開けられないよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0004",
   "jp": "{v:0021}あいつを行かせちゃだめだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0005",
   "jp": "{v:0022}あいつを止めなきゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0006",
   "jp": "{v:0023}あの人を止めないと！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0007",
   "jp": "{v:0024}とにかく急ぎましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0008",
   "jp": "{FFEE}ロックされる前に仮面騎士を倒せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0009",
   "jp": "{v:002D}ゲヴェルの名において、{n}言葉を知らぬ者を拒む扉となれ！{n}マジック・ロック！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0010",
   "jp": "‥‥{v:002E}フン！{n}これでお前たちは入れまい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0011",
   "jp": "{v:002F}ああ、せっかくの手がかりが‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0012",
   "jp": "あとはマジックロックをかけるだけだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0013",
   "jp": "まずい！{n}急いでヤツを倒すぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0014",
   "jp": "{v:0027}負けるかぁっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0015",
   "jp": "{v:0028}えいっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0016",
   "jp": "{v:0029}２年前のようにはいかんぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0017",
   "jp": "{v:002A}負けないもん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0018",
   "jp": "{v:002B}こんなところで死ぬわけにはいかないんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0019",
   "jp": "{v:002C}負けられません！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0020",
   "jp": "{v:0030}ぐ‥おぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0021",
   "jp": "{v:0031}また溶けちゃった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0022",
   "jp": "{v:0026}死ぬがよい！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0023",
   "jp": "くっ！{n}これではマジックロックが使えん‥‥。{p}ならば、力ずくでお前たちを倒すのみ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0024",
   "jp": "{v:0025}死ネ、死ネ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen183.0025",
   "jp": "{v:001D}グルル‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
