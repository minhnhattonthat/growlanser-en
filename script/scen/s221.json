  },
  {
   "id": "scen221.0001",
   "jp": "{FFEE}市民を守りながら戦え！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0002",
   "jp": "ここで死ぬわけには‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0003",
   "jp": "バ、バカな‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0004",
   "jp": "俺の夢もここまでか‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0005",
   "jp": "だ、だめだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0006",
   "jp": "死にたくない‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0007",
   "jp": "ああ‥‥守りきれなかった‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0008",
   "jp": "{v:0049}クックックッ！{n}いつまで無駄な抵抗をするつもりだ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0009",
   "jp": "{v:004A}ヴェンツェル！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0010",
   "jp": "{v:004B}おとなしく我が支配を受ければよいものを。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0011",
   "jp": "{v:004C}誰がアンタなんかの命令を聞くもんですか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0012",
   "jp": "‥‥{v:00A2}少しお仕置きが必要だな。{p}{v:004D}ムン！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0013",
   "jp": "{v:004E}さて、お前たちで、{n}どこまで民間人を守りきれるかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0014",
   "jp": "{v:004F}民間人って‥‥俺たちか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0015",
   "jp": "{v:0050}そんな‥ひどい‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0016",
   "jp": "{v:0052}では、楽しい余興の始まりだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen221.0017",
   "jp": "{v:0053}本当は最後まで見てみたいが、私も暇ではないのでね。{n}これで失礼させてもらうよ。",
   "en": "",
   "term": "end"
  }
 ]
}
