  },
  {
   "id": "scen084.0001",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen084.0002",
   "jp": "壁の口",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen084.0003",
   "jp": "北の沼地",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0004",
   "jp": "ちょっと待った！{p}これからゲヴェルのところに向かおうってんだ、{n}パーティーは５人いた方がいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0005",
   "jp": "そうだね。{n}戻って、メンバーを集めてきましょ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0006",
   "jp": "{v:0000}沼地ってここだよね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0007",
   "jp": "{v:0001}この岩場の裂け目から、{n}ゲヴェルの波動を感じる‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0008",
   "jp": "{v:0002}いよいよだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0009",
   "jp": "ゲヴェルを倒せ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0010",
   "jp": "{v:0066}う～ん、いい天気♪{n}アタシ達、勝ったんだね？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0011",
   "jp": "{v:0067}そうだな。{n}ルイセの能力があったしな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0012",
   "jp": "{v:0068}違うよ。{n}みんなが最後まであきらめなかったから、{n}勝てたんだよ。{p}{v:0069}ね？{n}お兄ちゃん？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0013",
   "jp": "なんと答えますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0014",
   "jp": "・みんなの力の勝利",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0015",
   "jp": "・ルイセに賛同する",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0016",
   "jp": "・ルイセのおかげ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0017",
   "jp": "・自分のおかげ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0018",
   "jp": "・返事をする気力がない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0019",
   "jp": "{v:006A}ああ、何だかいいわよねぇ、こういうのって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0020",
   "jp": "{v:006B}そ、そんな、お兄ちゃん！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0021",
   "jp": "{v:008F}照れない、照れない。{n}ルイセちゃんのグローシュがなかったら、{n}どうなってたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0022",
   "jp": "{v:006C}ティピちゃーん、きーっく！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0023",
   "jp": "％×＆★！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0024",
   "jp": "{v:006D}もぉ、こりないなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0025",
   "jp": "{v:006E}ん？{n}黙りこんじゃって、つれないわねぇ‥‥。{p}{v:006F}何か気がかりなことでもあるの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0026",
   "jp": "{v:0070}ティピ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0027",
   "jp": "{FB00}‥‥{v:0071}あ‥‥。{p}‥{v:0072}あはははっ！{n}今のナシね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0028",
   "jp": "{v:0073}ま、これで世の中も平和になるってもんだな。{n}これからどうする？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0029",
   "jp": "{v:0074}う～んと‥‥あっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0030",
   "jp": "{v:0075}ライエル？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0031",
   "jp": "{v:0076}ライエル将軍！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0032",
   "jp": "{v:0077}ご無事でしたか、陛下！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0033",
   "jp": "{v:0078}ええ。{n}これで人々も安心して暮らせるでしょう。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0034",
   "jp": "{v:0079}ん？　どうしたのだ、こんなところで‥‥。{p}{v:007A}まさか、もう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0035",
   "jp": "{v:007B}うん。{n}ゲヴェルは倒しましたよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0036",
   "jp": "{v:007C}遅かったか‥‥。{p}{v:007D}加勢は多い方がいいのではと思い、{n}やってきたのだが、どうやら遅かったようだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0037",
   "jp": "{v:007E}もうちょっと早く来てくれればよかったのに！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0038",
   "jp": "{v:007F}すまない。{n}王都に攻め込む敵を一掃するのに手間取ったのでな。{p}{v:0080}ところで、これからみなさんはどうなされますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0039",
   "jp": "{v:0081}僕は、一度村に帰りますよ。{n}村の人々は、僕の家族も同然ですから。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0040",
   "jp": "アリオストの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0041",
   "jp": "{v:0082}そろそろ王としての責務を果たさないと{n}いけませんから、城に戻りますよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0042",
   "jp": "エリオットの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0043",
   "jp": "{v:0083}本来のナイツの仕事があるからな。{n}城に戻らざるをえん。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0044",
   "jp": "ジュリアンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0045",
   "jp": "{v:0084}お父さんの容態も気になるので、保養施設に戻ります。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0046",
   "jp": "カレンの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0047",
   "jp": "‥‥{v:0085}コイツらとは一緒にいられねぇ。{n}騙されていたとはいえ、{n}ローランディア王国には迷惑かけちまったからな。{p}{v:0086}かといって、バーンシュタイン王国にもいられねぇ。{n}とりあえず、自分の家に戻るさ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0048",
   "jp": "ゼノスの装備を回収しますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0049",
   "jp": "{v:0087}アタシは‥‥帰るところがないの。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0050",
   "jp": "{v:0088}それじゃ、一緒においでよ！{n}わたしの家にお泊まりしようよ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0051",
   "jp": "{v:0089}きゃーー★{n}ルイセちゃん、ルイセちゃん♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0052",
   "jp": "{v:008A}では、私も戻るとしよう。{n}いろいろと世話になった。{n}また会おう、ローランディア王国の騎士よ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0053",
   "jp": "{v:008B}アタシたちも帰りましょ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0054",
   "jp": "{v:008C}お母さんも心配してるしね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0055",
   "jp": "{v:008D}よっしゃ、帰るか！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0056",
   "jp": "ゲヴェルを倒した！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0057",
   "jp": "現在、調査中です。{n}しばらくしてから、お越し下さい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0058",
   "jp": "外には出てきませんが、内部でまた動きがある様です。{n}腕試しもかねて、調査なさいますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0059",
   "jp": "ところで、準備はよろしいのですか？{n}一度降りると、なかなか帰ってこられませんよ。{n}それでも行くと言うのなら、お気をつけて、どうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0060",
   "jp": "お気をつけて、どうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0061",
   "jp": "{v:0003}あの影は！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0062",
   "jp": "{v:0004}やっぱりここなのね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0063",
   "jp": "‥‥‥{v:0005}ダメ。{p}{v:0006}ゲヴェルの思念波が強すぎて、{n}完全に遮断できない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0064",
   "jp": "{v:0007}ルイセちゃんの能力でもダメなのか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0065",
   "jp": "{v:0008}さすが本体の近くだと勝手が違うか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0066",
   "jp": "{v:0009}簡単だ。{n}全部ブチ殺せばいい。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0067",
   "jp": "‥‥{v:000A}力ずくで通るのみ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0068",
   "jp": "{v:000B}でも、引くことは出来ませんね。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0069",
   "jp": "{v:000C}ここで怯んではいられませんね。{n}がんばりましょう！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0070",
   "jp": "{v:000E}なんだ？{n}行き止まりか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0071",
   "jp": "{v:000F}う～ん‥‥。{n}何か仕掛けがあるのかな？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0072",
   "jp": "{v:0010}うわぁっ！{n}ナニ、コレェ！？{n}こっち見てるぅ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0073",
   "jp": "もう移動できないようだ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0074",
   "jp": "この穴は活動を再開しているようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0075",
   "jp": "　{n}　　　　　　　　開かない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0076",
   "jp": "～フライシェベルグ～第１階層",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0077",
   "jp": "　{n}　　　　　　　開かない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0078",
   "jp": "『{FFEF}トリニトレイト{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0079",
   "jp": "　{n}　　　　『{FFEF}トリニトレイト{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0080",
   "jp": "『{FFEF}秘伝書{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0081",
   "jp": "　{n}　　　　　　『{FFEF}秘伝書{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0082",
   "jp": "『{FFEF}シャドーブレイド{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0083",
   "jp": "　{n}　　　『{FFEF}シャドーブレイド{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0084",
   "jp": "『{FFEF}天女の羽衣{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0085",
   "jp": "　{n}　　　　　『{FFEF}天女の羽衣{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0086",
   "jp": "～フライシェベルグ～第２階層",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0087",
   "jp": "こちらからは開かない。{n}一方通行のようだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0088",
   "jp": "　{n}　　　　鍵を{FFEF}４つ{FFF1}手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0089",
   "jp": "{v:0012}鍵？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0090",
   "jp": "　{n}　　　　　　{v:0013}‥鍵‥鍵‥数‥少ない‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0091",
   "jp": "　{n}　　　　　　{v:0014}‥部屋‥部屋‥数‥多い‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0092",
   "jp": "　{n}　　　　　　{v:0015}‥鍵‥鍵‥使う‥減る‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0093",
   "jp": "　{n}　　　　　　{v:0016}‥部屋‥部屋‥仕掛け‥楽‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0094",
   "jp": "{v:0017}ん～？{n}何の事かしら？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0095",
   "jp": "{v:0011}敵よ！{n}みんな、がんばって！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0096",
   "jp": "床に鍵穴のような物が{FFEF}２つ{FFF1}開いている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0097",
   "jp": "鍵を２つ使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0098",
   "jp": "　{n}　　　　　　　鍵を持っていない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0099",
   "jp": "　{n}　　　　　　　　鍵が足りない！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0100",
   "jp": "『{FFEF}エストック{FFF1}』を見つけたが、{n}これ以上、持つことはできない‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0101",
   "jp": "　{n}　　　　　『{FFEF}エストック{FFF1}』を手に入れた！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0102",
   "jp": "床に鍵穴のような物が{FFEF}１つ{FFF1}開いている。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0103",
   "jp": "鍵を１つ使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0104",
   "jp": "敵よ！{n}みんな、頑張って！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0105",
   "jp": "鍵穴が上下に２つある。{n}鍵を使いますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0106",
   "jp": "・上の鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0107",
   "jp": "・下の鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0108",
   "jp": "・上下、２つの鍵穴へ",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0109",
   "jp": "・使わない",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen084.0110",
   "jp": "床に鍵穴が１つある。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen084.0111",
   "jp": "鍵を使いますか？",
   "en": "",
   "term": "end"
