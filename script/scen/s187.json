  {
   "id": "scen187.0001",
   "jp": "{FFEE}ルイセを守れ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0002",
   "jp": "{v:0047}どうしてルイセちゃんを狙うの？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0003",
   "jp": "{v:0048}邪魔なんだよ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0004",
   "jp": "{v:0049}邪魔？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0005",
   "jp": "{v:004A}グローシュを持つ者はな！{n}とくにヤツの持つグローシュは強すぎる！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0006",
   "jp": "{v:004B}まさか一連のグローシアン狩りはお前の仕業か！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0007",
   "jp": "{v:004C}さてな！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0008",
   "jp": "{v:0053}きゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0009",
   "jp": "{v:0054}そんな‥‥ルイセちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0010",
   "jp": "{v:0055}くっくっくっ！{p}{v:0056}これで我々の邪魔をするものはいなくなったぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0011",
   "jp": "むぅぅ‥‥。{n}無理をしすぎたか‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0012",
   "jp": "{v:0057}ぐ‥‥まさか‥{FE1E}‥{FFF9}{FC01}{FE1E}‥{FE1E}‥{FE1E}‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0013",
   "jp": "{v:0058}ふむ‥‥終わったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0014",
   "jp": "{v:004D}ここか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0015",
   "jp": "{v:004E}えっ？{n}敵？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0016",
   "jp": "{v:004F}早とちりするでない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0017",
   "jp": "{v:0050}えっ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0018",
   "jp": "{v:0051}お前ほどのグローシュを持つ者を{n}殺させるわけにはいかん。{n}及ばずながら手助けさせてもらうぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen187.0019",
   "jp": "{v:0052}くっ！{n}邪魔なじじいめ！",
   "en": "",
   "term": "end"
  }
 ]
}
