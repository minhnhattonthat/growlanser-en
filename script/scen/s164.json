  },
  {
   "id": "scen164.0001",
   "jp": "アナウンス",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen164.0002",
   "jp": "１回戦開始",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0003",
   "jp": "おい、どういう手順で戦う？{n}バトルロイヤルだから、まともに戦っても{n}ふくろにされるだけだぜ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0004",
   "jp": "決まってるだろ。{n}まず弱そうな奴からつぶす！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0005",
   "jp": "へっへっへ‥‥。{n}そうだな。{n}じゃあ、最初はあのガキどもだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0006",
   "jp": "そういうことだ。{n}行くぞ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0007",
   "jp": "{v:0008}もぉ～～！{n}ドジなんだからぁ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0008",
   "jp": "{v:0054}きゃあっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0009",
   "jp": "{v:0055}ああっ！ルイセちゃんが！{n}もぅっ！敵討ちよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0010",
   "jp": "遠くからパチンコを撃っていれば{n}勝てると思ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0011",
   "jp": "我々が勝つはずだったのに‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0012",
   "jp": "初戦敗退だなんて‥‥。{n}とほほ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0013",
   "jp": "や、やるじゃないの！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0014",
   "jp": "も、もうダメだ‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0015",
   "jp": "くやし～！{n}結構、いけると思ったのに‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0016",
   "jp": "勝負あり！{p}１回戦Ｄグループの勝者が決まりました！{n}見事、２回戦進出の権利を獲得したチームは‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0017",
   "jp": "この王都ローザリア出身の兄妹。{n}兄妹ならではの絶妙なコンビプレイを{n}またもや見せつけてくれました！{p}これは今後の試合展開が、面白くなってきそうだ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0018",
   "jp": "おお～っと！{n}まずは１チームがここで脱落！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0019",
   "jp": "ついに２チームがここで脱落！{n}果たして２回戦進出のキップを手にするのは、{n}どちらのチームか！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0020",
   "jp": "そんなの、俺たちに決まってるじゃねぇか。{n}あんなガキどもに、負けてたまるかよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0021",
   "jp": "ふん、確かにそうだね。{n}だけど、気を抜くんじゃないよ！{n}奴ら、魔法を使うからね！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0022",
   "jp": "ふん、確かにそうだね。{n}だけど、気を抜くんじゃないよ！{n}奴ら、魔法が使えそうだよ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0023",
   "jp": "心配ねぇって。{n}魔術師がいるだろうからって、{n}アミュレットを買ったじゃねぇか。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0024",
   "jp": "奴ら、魔法を使うのか‥‥。{n}アミュレットを買っといて正解だったな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen164.0025",
   "jp": "奴ら、魔法は使えないのか？{n}アミュレットを買ったのに、無駄だったか‥‥。",
   "en": "",
   "term": "end"
  }
 ]
}
