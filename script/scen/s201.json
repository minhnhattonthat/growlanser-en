  {
   "id": "scen201.0001",
   "jp": "バーンシュタイン兵隊長",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen201.0002",
   "jp": "バーンシュタイン兵",
   "en": "",
   "term": "null"
  },
  {
   "id": "scen201.0003",
   "jp": "もう、たまらん‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0004",
   "jp": "ひ、ひでぇや‥‥",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0005",
   "jp": "ぬをっ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0006",
   "jp": "{v:0035}何だか妙だな‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0007",
   "jp": "{v:0036}妙？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0008",
   "jp": "{v:0037}奴ら、バーンシュタインの連中じゃねぇぞ。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0009",
   "jp": "{v:0038}それじゃ、何だろ？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0010",
   "jp": "{v:0039}さっきから聞き覚えのある名前が出てるじゃない。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0011",
   "jp": "{v:0031}くっ！{n}このままでは突破されてしまう‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0012",
   "jp": "{v:0032}俺はグレンガル様に伝えてくる！{n}それまでなんとしても奴らを防ぐんだ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0013",
   "jp": "{v:0033}わ、わかりました！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0014",
   "jp": "{v:0034}ああ、連絡されちゃうよ！{n}急がなきゃ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0015",
   "jp": "{FFEE}隊長を逃がすな！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0016",
   "jp": "よし、ここまで来れば。{n}味方と連絡が取れるぞ！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen201.0017",
   "jp": "{v:003B}バカ、バカ！{n}逃げられちゃったじゃない！",
   "en": "",
   "term": "end"
  }
 ]
}
