  },
  {
   "id": "scen233.0001",
   "jp": "{FFEE}ジュリアンを守り仮面騎士を倒せ！{FFF1}",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0002",
   "jp": "{v:00FC}ぐぉぉ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0003",
   "jp": "{v:00FE}ち、ちょっと、ジュリアン！{n}目を開けてよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0004",
   "jp": "{v:00FF}ち、ちょっと、アンタ！{n}目を開けてよ！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0005",
   "jp": "ル、ルイセちゃん！！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0006",
   "jp": "{v:00F8}お、お兄ちゃん！？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0007",
   "jp": "ルイセにも戦わせますか？",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0008",
   "jp": "・一緒に戦わせる",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen233.0009",
   "jp": "・手出し無用！",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen233.0010",
   "jp": "{v:00F9}うん、お兄ちゃん！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0011",
   "jp": "{v:00FA}奇襲に失敗した以上、長居は無用か。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0012",
   "jp": "{v:00FB}この借り、忘れはせん。{n}次に会うときは、覚悟しておくのだな。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0013",
   "jp": "{v:00F5}負けるな！{n}それでも私が認めた男か！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0014",
   "jp": "{v:00F6}ぐぅ‥‥！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0015",
   "jp": "{v:00F7}そのまま一気に蹴散らせ！",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen233.0016",
   "jp": "お兄ちゃん大丈夫！？",
   "en": "",
   "term": "end"
  }
 ]
}
