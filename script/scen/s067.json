   "jp": "・{FFEF}{s:0000}{FFF1}（ウォレス）",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0035",
   "jp": "・{FFEF}ティピちゃん王国{FFF1}",
   "en": "",
   "term": "end",
   "unref": true
  },
  {
   "id": "scen067.0036",
   "jp": "カラジューム",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0037",
   "jp": "うふふっ！{n}嬉しいですぅ♪",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0038",
   "jp": "ムスカリ",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0039",
   "jp": "グローランド",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0040",
   "jp": "選んでもらえて光栄です。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0041",
   "jp": "ワイワイランド",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0042",
   "jp": "ほ、本当にいいのかなぁ‥‥。",
   "en": "",
   "term": "end"
  },
  {
   "id": "scen067.0043",
   "jp": "ワクワクランド",
